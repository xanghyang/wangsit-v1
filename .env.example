# Environment variables — copy this file to .env and fill in your values
# Never commit the real .env file to version control

# Required for --live mode only
POLY_PRIVATE_KEY=your_polygon_private_key_here
POLY_PROXY_WALLET=your_polymarket_proxy_wallet_address_here

# Optional production ops
HEALTHCHECK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional risk/compound guards
BANKROLL_FRACTION=0.02
COMPOUND_RATE=0.02
MIN_TRADE_AMOUNT=0.99
MAX_TRADE_AMOUNT=25
MAX_DAILY_LOSS=15
MAX_CONSECUTIVE_LIVE_TRADES=24
STATE_PATH=data/state.json
